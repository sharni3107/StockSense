# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Only needed for privileged admin operations (creating users from the seed script). Never sent to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth -> JWT Settings -> "JWT Secret" (used to verify access tokens locally, no network round trip)
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Project Settings -> Database -> Connection string (use the "Session pooler" or direct connection, URI format)
# Example: postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# If stock is allowed to go negative when a delivery/transfer exceeds available quantity
ALLOW_NEGATIVE_STOCK=false
