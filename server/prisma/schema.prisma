generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("WAREHOUSE_STAFF")
  createdAt    DateTime  @default(now())

  operations   InventoryOperation[]
  ledgerEntries StockLedger[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unit          String
  reorderLevel  Int      @default(0)
  createdAt     DateTime @default(now())

  stocks         Stock[]
  operationItems OperationItem[]
  ledgerEntries  StockLedger[]
  reorderingRules ReorderingRule[]

  @@index([sku])
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  address   String?
  locations Location[]
}

model Location {
  id          String    @id @default(cuid())
  name        String
  code        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  stocks              Stock[]
  reorderingRules      ReorderingRule[]
  sourceOperations     InventoryOperation[] @relation("SourceLocation")
  destinationOperations InventoryOperation[] @relation("DestinationLocation")
  ledgerAsSource       StockLedger[] @relation("LedgerSource")
  ledgerAsDestination  StockLedger[] @relation("LedgerDestination")

  @@unique([warehouseId, code])
}

model Stock {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Float    @default(0)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model InventoryOperation {
  id                   String          @id @default(cuid())
  reference            String          @unique
  type                 String
  status               String          @default("DRAFT")
  partnerName          String?
  sourceLocationId     String?
  destinationLocationId String?
  createdById          String
  createdAt            DateTime        @default(now())
  validatedAt          DateTime?

  sourceLocation      Location? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location? @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy           User      @relation(fields: [createdById], references: [id])

  items         OperationItem[]
  ledgerEntries StockLedger[]

  @@index([type])
  @@index([status])
}

model OperationItem {
  id          String  @id @default(cuid())
  operationId String
  productId   String
  quantity    Float

  operation InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id])
}

model StockLedger {
  id                    String        @id @default(cuid())
  productId             String
  operationId           String
  sourceLocationId      String?
  destinationLocationId String?
  quantityChange        Float
  balanceAfter          Float
  operationType         String
  createdById           String
  createdAt             DateTime      @default(now())

  product             Product            @relation(fields: [productId], references: [id])
  operation           InventoryOperation @relation(fields: [operationId], references: [id])
  sourceLocation      Location?          @relation("LedgerSource", fields: [sourceLocationId], references: [id])
  destinationLocation Location?          @relation("LedgerDestination", fields: [destinationLocationId], references: [id])
  createdBy           User               @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model ReorderingRule {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  minQty     Float
  maxQty     Float

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
}
